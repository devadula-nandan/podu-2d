{
  "name": "podu-2d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A faithful, data-driven 2D reimplementation of Pokemon Duel on a deterministic event-sourced engine.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fuzz": "node tools/fuzz.mjs",
    "fuzz": "node tools/fuzz.mjs",
    "e2e": "playwright test",
    "e2e:vite": "playwright test -c playwright.vite.config.ts",
    "sync": "node server/sync.mjs",
    "start": "node server/sync.mjs --static dist",
    "data:validate": "node tools/validate.mjs",
    "data:build": "node tools/build-content.mjs && node tools/validate.mjs",
    "verify": "npm run typecheck && npm run lint && npm run data:validate && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "zod": "^3.23.8"
  }
}
