{
  "name": "podu-2d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A faithful, data-driven 2D reimplementation of Pokemon Duel on a deterministic event-sourced engine.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fuzz": "node tools/fuzz.mjs",
    "fuzz": "node tools/fuzz.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build",
    "e2e": "playwright test",
    "e2e:vite": "playwright test -c playwright.vite.config.ts",
    "sync": "node server/sync.mjs",
    "start": "node server/sync.mjs --static dist",
    "data:import": "node tools/import-figures.mjs",
    "data:validate": "node tools/validate.mjs",
    "data:build": "node tools/import-figures.mjs && node tools/validate.mjs",
    "verify": "npm run typecheck && npm run lint && npm run data:validate && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "storybook": "^8.6.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "three": "^0.186.1",
    "zod": "^3.23.8"
  }
}
